{
  "project": "11_pipeline_dag",
  "business_question": "Twelve pipelines with shared dependencies are run by hand. What does proper orchestration \u2014 ordering, caching, parallelism \u2014 actually save, measured on the real graph rather than assumed?",
  "phases": [
    {
      "name": "business_understanding",
      "title": "Business Understanding",
      "summary": "Running pipelines by hand fails in three specific ways as a project grows: wrong order produces stale results silently, re-running unchanged work wastes time, and independent work runs sequentially for no reason. An orchestrator addresses all three, but how much it is worth depends entirely on the shape of the dependency graph \u2014 which is measurable.",
      "decisions": [
        {
          "question": "How is the value of orchestration established?",
          "choice": "Measured on this repository's real graph and real runtimes.",
          "rationale": "Speedup from parallelism is bounded by the critical path, which is a property of the specific graph. Quoting a general figure would be meaningless. Durations come from each pipeline's committed _run block, so the analysis describes this portfolio.",
          "alternatives_rejected": [
            "Benchmark on a synthetic DAG \u2014 the result would describe the synthetic graph and nothing else.",
            "State that parallelism helps \u2014 true and useless without the bound."
          ]
        }
      ],
      "evidence": {
        "scheduler": "level-parallel with LPT packing"
      },
      "risks": []
    },
