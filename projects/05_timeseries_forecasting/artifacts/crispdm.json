    {
      "name": "data_preparation",
      "title": "Data Preparation",
      "summary": "Minimal and identical across series: parse dates, coerce values to float, drop unparseable rows, sort chronologically. No imputation, no outlier removal \u2014 a smoothed series would make every model look better than it is, and the sunspot and temperature series contain genuine extremes that a forecaster ought to be judged on.",
      "decisions": [],
